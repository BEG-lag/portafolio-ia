// Plantilla de pandoc para Typst: el portafolio con el diseño de pivotek.mx
// (tinta nocturna, verde lima y los tres colores del semáforo; Inter, JetBrains Mono
// y Cormorant Garamond en cursiva). Se usa desde build/generar-pdf.sh; los metadatos
// vienen de build/meta-{en,es}.yaml y build/pdf.lua arma las cejas y los titulares.

#let tinta = rgb("#0a0c10")
#let tinta-2 = rgb("#11141b")
#let tinta-3 = rgb("#191d27")
#let papel = rgb("#eceee6")
#let suave = rgb("#c9ccc4")
#let gris = rgb("#969dab")
#let linea = rgb("#2a2d33")
#let lima = rgb("#cfff45")
#let ambar = rgb("#ffb648")
#let coral = rgb("#ff5d47")
#let sans = ("Inter", "Helvetica Neue", "Arial")
#let mono = ("JetBrains Mono", "Menlo")
#let serif = ("Cormorant Garamond", "Georgia")

#let dos(n) = if n < 10 { "0" + str(n) } else { str(n) }
#let luces(t: 4.4pt) = box(baseline: -0.02em, stack(dir: ltr, spacing: 2.4pt,
  circle(radius: t / 2, fill: lima, stroke: none),
  circle(radius: t / 2, fill: ambar, stroke: none),
  circle(radius: t / 2, fill: coral, stroke: none)))
#let ceja(cuerpo, color: gris) = text(font: mono, size: 6.8pt, tracking: 0.1em, fill: color, upper(cuerpo))
#let numsub(n) = text(font: mono, size: 0.66em, weight: "regular", fill: lima, baseline: -0.12em)[#n#h(7pt)]
#let pastilla(cuerpo) = box(stroke: 0.6pt + linea, radius: 99pt, inset: (x: 7.5pt, y: 4.6pt),
  text(font: mono, size: 6.6pt, fill: papel)[#text(fill: lima)[+] #cuerpo])
#let horizontalrule = block(above: 16pt, below: 16pt, line(length: 100%, stroke: 0.5pt + linea))
#let divider = horizontalrule

// Titular de sección: Inter grueso y la cursiva en lima, como los h2 del sitio
#let titular(c) = block(sticky: true, above: 9pt, below: 16pt, width: 100%)[
  #set par(justify: false, leading: 0.36em)
  #text(size: 22pt, weight: "bold", tracking: -0.04em, fill: papel)[#c]
]

// Índice con número de página
#let indice() = context {
  let hs = query(selector(heading.where(level: 1)).after(here()))
  for h in hs {
    let p = counter(page).at(h.location()).first()
    block(above: 0pt, below: 0pt, width: 100%, inset: (y: 7pt), stroke: (bottom: 0.5pt + linea),
      link(h.location(), grid(columns: (1fr, auto), column-gutter: 12pt, align: (left + horizon, right + horizon),
        text(font: mono, size: 7.6pt, tracking: 0.05em, fill: papel, upper(h.body)),
        text(font: mono, size: 7.6pt, fill: gris, dos(p)))))
  }
}

$if(highlighting-definitions)$
$highlighting-definitions$
$endif$

#set document(title: [$pdf-title$], author: "Benjamín Esponda García")
#set text(font: sans, size: 9.2pt, fill: suave, lang: "$lang$", hyphenate: false)
#set par(justify: false, leading: 0.7em, spacing: 1.1em)
#set page(
  paper: "us-letter",
  fill: tinta,
  margin: (x: 2cm, top: 2.35cm, bottom: 2.1cm),
  header: context [
    #set text(font: mono, size: 6.6pt, tracking: 0.1em, fill: gris)
    #grid(columns: (auto, 1fr), align: (left + horizon, right + horizon),
      box(stroke: 0.6pt + linea, radius: 99pt, inset: (x: 7pt, y: 4.4pt))[#luces(t: 4pt) #h(3pt) #text(fill: papel)[BEG]],
      upper[$cabeza-der$])
  ],
  footer: context [
    #set text(font: mono, size: 6.6pt, tracking: 0.08em, fill: gris)
    #grid(columns: (1fr, auto), align: (left, right),
      [pivotek.mx],
      [#text(fill: papel)[#dos(counter(page).get().first())] / #dos(counter(page).final().first())])
  ],
  // barra de avance, como la del sitio: lima, ámbar y coral
  background: context {
    let n = counter(page).get().first()
    let t = counter(page).final().first()
    place(top + left, rect(width: 100% * n / t, height: 2.6pt, stroke: none,
      fill: gradient.linear(lima, ambar, coral)))
  },
)

// Encabezados: el nivel 1 es la ceja de la sección (el titular grande lo pone pdf.lua)
#show heading: set text(font: sans, fill: papel)
#show heading.where(level: 1): it => block(sticky: true, above: 34pt, below: 0pt, width: 100%)[
  #line(length: 100%, stroke: 0.5pt + linea)
  #v(10pt)
  #ceja(it.body)
]
#show heading.where(level: 2): it => block(sticky: true, above: 20pt, below: 9pt)[
  #text(size: 12.6pt, weight: "semibold", tracking: -0.02em)[#it.body]
]
#show heading.where(level: 3): it => block(sticky: true, above: 14pt, below: 7pt)[
  #text(size: 10.4pt, weight: "semibold", tracking: -0.01em)[#it.body]
]

// Texto, listas, enlaces, código y citas
#show strong: set text(weight: "semibold", fill: papel)
#show emph: it => text(font: serif, style: "italic", weight: "regular", fill: lima, size: 1.14em, tracking: -0.01em, it.body)
#show link: it => if type(it.dest) == str {
  underline(stroke: 0.7pt + lima, offset: 2.2pt, evade: true, it)
} else { it }
#set list(marker: box(baseline: -0.24em, circle(radius: 1.6pt, fill: lima, stroke: none)), indent: 2pt, body-indent: 8pt)
#set enum(numbering: n => text(font: mono, size: 0.84em, fill: lima)[#dos(n)], indent: 0pt, body-indent: 8pt)
#show raw: set text(font: mono, size: 0.86em)
#show raw.where(block: false): it => box(fill: lima.transparentize(90%), inset: (x: 3pt), outset: (y: 2.4pt), radius: 3pt, text(fill: lima, it))
#show raw.where(block: true): it => block(fill: tinta-2, stroke: 0.6pt + linea, radius: 10pt, inset: 11pt, width: 100%, text(fill: papel, it))
#show quote.where(block: true): it => block(fill: tinta-2, radius: 8pt, inset: (x: 13pt, y: 10pt), width: 100%,
  stroke: (left: 2pt + lima), it.body)

// Tablas: filas separadas por líneas finas y encabezado en mono, como las listas del sitio
#set table(
  inset: (x: 6pt, y: 6.5pt),
  fill: none,
  stroke: (x, y) => (
    top: if y == 1 { 0.8pt + lima.transparentize(45%) } else if y > 1 { 0.5pt + linea } else { none },
  ),
)
#set table.hline(stroke: 0pt)
#show table: set text(size: 8.3pt)
#show table: set par(justify: false, leading: 0.55em)
#show table.cell.where(y: 0): it => text(font: mono, size: 6.5pt, tracking: 0.08em, fill: lima, upper(it))
#show table.cell.where(x: 0): set text(weight: "semibold", fill: papel)
#show figure.where(kind: table): set block(breakable: true)
#show figure: set block(breakable: true)

// Figuras: la imagen va en una tarjeta, como las del sitio
#show figure.where(kind: image): it => block(width: 100%, above: 14pt, below: 14pt)[
  #block(width: 100%, fill: tinta-2, stroke: 0.6pt + linea, radius: 14pt, inset: 12pt, clip: true, align(center, it.body))
  #if it.caption != none { v(2pt); align(left, text(font: mono, size: 6.8pt, fill: gris, tracking: 0.04em, it.caption.body)) }
]

#set smartquote(enabled: true)

// Portada: el inicio del sitio
#let cifra(num, suf, texto, destacada: false) = grid.cell(
  fill: if destacada { lima } else { none },
  inset: (x: 11pt, top: 12pt, bottom: 11pt),
)[
  #text(size: 27pt, weight: "bold", tracking: -0.05em, fill: if destacada { tinta } else { papel })[#num#text(fill: if destacada { tinta } else { lima })[#suf]]
  #v(3pt)
  #block(height: 2.4em)[#set par(leading: 0.5em); #text(size: 7pt, fill: if destacada { tinta } else { gris })[#texto]]
]

#let puntos(ancho, alto) = {
  let paso = 11pt
  let cols = int(ancho / paso)
  let filas = int(alto / paso)
  for i in range(cols) {
    for j in range(filas) {
      let r = calc.fract(calc.abs(calc.sin(i * 12.9898 + j * 78.233)) * 43758.5453)
      // más densos arriba a la derecha, como el lienzo del sitio
      let d = calc.sqrt(calc.pow((i - cols * 0.78) / (cols * 0.55), 2) + calc.pow((j - filas * 0.3) / (filas * 0.6), 2))
      if r > 0.18 + d * 0.75 {
        let verde = r > 0.86
        let a = calc.min(85, int((1 - d) * 120))
        if a > 8 {
          place(top + left, dx: i * paso + paso / 2, dy: j * paso + paso / 2,
            circle(radius: if verde { 1.1pt } else { 0.8pt }, stroke: none,
              fill: (if verde { lima } else { rgb("#5d6b2c") }).transparentize(100% - a * 1%)))
        }
      }
    }
  }
}

#page(fill: tinta, margin: 0pt, header: none, footer: none, background: none)[
  #place(top + left, puntos(612pt, 470pt))
  #pad(x: 44pt, top: 34pt, bottom: 34pt)[
    #set text(fill: papel)
    #grid(columns: (auto, 1fr, auto), align: horizon,
      box(stroke: 0.6pt + linea, fill: tinta.transparentize(25%), radius: 99pt, inset: (x: 9pt, y: 6pt))[
        #luces(t: 5pt) #h(4pt) #text(font: mono, size: 7.4pt, tracking: 0.14em)[BEG]],
      [],
      box(fill: lima, radius: 99pt, inset: (x: 10pt, y: 6pt), text(font: mono, size: 7.4pt, fill: tinta, weight: "regular")[pivotek.mx]))
    #v(1fr)
    #ceja[$ceja-portada$]
    #v(8pt)
    #context {
      let ancho = 524pt
      let w1 = measure(text(font: sans, weight: "bold", size: 100pt, tracking: -0.065em)[$nombre-1$]).width
      let w2 = measure(text(font: sans, weight: "bold", size: 62pt, tracking: -0.05em)[$nombre-2$]).width
      let k = calc.min(ancho / w1, ancho / w2)
      set par(leading: 0pt, spacing: 0pt)
      block(text(font: sans, weight: "bold", size: 100pt * k, tracking: -0.065em, fill: papel, bottom-edge: "descender")[$nombre-1$])
      v(3pt)
      block(text(font: sans, weight: "bold", size: 62pt * k, tracking: -0.05em,
        fill: tinta.transparentize(100%), stroke: 0.9pt + papel)[$nombre-2$])
    }
    #v(22pt)
    #line(length: 100%, stroke: 0.5pt + linea)
    #v(14pt)
    #grid(columns: (1fr, auto), column-gutter: 22pt, align: (left + bottom, right + bottom),
      block[#set par(leading: 0.42em); #text(size: 19pt, tracking: -0.025em)[$linea$]],
      text(font: mono, size: 6.6pt, fill: gris, tracking: 0.03em)[#set par(leading: 0.95em); $datos-1$ \ $datos-2$])
    #v(14pt)
    #block[#set par(leading: 0.9em)
$for(chips)$
      #pastilla[$chips$]
$endfor$
    ]
    #v(26pt)
    #grid(columns: (1fr, 1fr, 1fr), stroke: 0.5pt + linea,
$for(cifras)$
      cifra([$cifras.num$], [$cifras.suf$], [$cifras.texto$]$if(cifras.destacada)$, destacada: true$endif$),
$endfor$
    )
    #v(24pt)
    #grid(columns: (1fr, auto), column-gutter: 16pt, align: (left + bottom, right + bottom),
      text(font: mono, size: 7pt, fill: papel, tracking: 0.02em)[$contacto$],
      text(font: mono, size: 7pt, fill: lima, tracking: 0.04em)[$fecha$])
    #v(8pt)
    #block(width: 80%)[#set par(leading: 0.6em); #text(size: 6.6pt, fill: gris)[$aviso$]]
  ]
]
#counter(page).update(1)

$body$
